{
  "name": "zhixu-study-server",
  "version": "2.0.0",
  "private": true,
  "description": "云帆·AI 学习领航引擎 — 后端服务（Next.js 全栈）",
  "scripts": {
    "sync": "node scripts/sync-public.mjs",
    "predev": "npm run sync",
    "dev": "next dev -p 3000",
    "prebuild": "npm run sync",
    "build": "next build",
    "prestart": "npm run sync",
    "start": "next start -p 3000",
    "db:init": "tsx scripts/init.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "better-sqlite3": "11.3.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@types/better-sqlite3": "7.6.11",
    "@types/bcryptjs": "2.4.6",
    "tsx": "4.19.1"
  }
}