# 云帆后端环境变量示例
# 复制为 .env 后填入真实值，.env 已加入 gitignore

# 服务端口（默认 3000）
PORT=3000

# JWT 签名密钥（生产环境必须用 32 位以上随机字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-long-random-string-in-production-please-please-please"

# 数据库文件位置
DATABASE_PATH="./data/zhixu.db"

# CORS 允许的来源（多个用逗号分隔，* 表示全部；本地开发用 * 即可）
ALLOWED_ORIGINS="*"

# 是否启用 AI 路由代理（默认 false，前端走自己的 API Key）
# 启用需要配置对应厂商密钥
AI_PROXY_ENABLED="false"
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=